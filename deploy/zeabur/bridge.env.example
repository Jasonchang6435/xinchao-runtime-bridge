# New service only. Do not overwrite the heart service with this file.
PORT=8080
ZBPACK_DOCKERFILE_PATH=Dockerfile
DRY_RUN=true
XINCHAO_BRIDGE_BASE_URL=https://vvxinchao.zeabur.app
XINCHAO_BRIDGE_MACHINE_TOKEN=REPLACE_WITH_INDEPENDENT_64_HEX_TOKEN
XINCHAO_BRIDGE_ACCEPT_SELF_SIGNALS=true
XINCHAO_BRIDGE_INJECTOR_MODE=webhook
# Set both before explicitly switching DRY_RUN=false.
# XINCHAO_BRIDGE_WEBHOOK_URL=https://your-owned-runtime.example.com/xinchao/wake
# XINCHAO_BRIDGE_WEBHOOK_TOKEN=REPLACE_WITH_DIFFERENT_64_HEX_TOKEN
XINCHAO_BRIDGE_STREAM_IDLE_MS=90000
XINCHAO_BRIDGE_RETRY_MIN_MS=1000
XINCHAO_BRIDGE_RETRY_MAX_MS=30000
